{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@ %@": {
      "comment": "A named portion and its size, e.g. bottle 500 ml",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@ %3$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ %3$@"
          }
        }
      }
    },
    "%@ above the usual %lld–%lld%%": {
      "comment": "One item in the unusual-macro list",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ above the usual %2$lld–%3$lld%%"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a szokásos %2$lld–%3$lld%% felett"
          }
        }
      }
    },
    "%@ below the usual %lld–%lld%%": {
      "comment": "One item in the unusual-macro list",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ below the usual %2$lld–%3$lld%%"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a szokásos %2$lld–%3$lld%% alatt"
          }
        }
      }
    },
    "%@ g": {
      "comment": "A nutrient amount in grams, e.g. 12.5 g",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ g"
          }
        }
      }
    },
    "%@ kcal": {
      "comment": "An energy amount, e.g. 240 kcal",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kcal"
          }
        }
      }
    },
    "%@ kcal per 100 %@": {
      "comment": "Energy density of a food, e.g. 52 kcal per 100 g",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ kcal per 100 %2$@"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kcal / 100 %2$@"
          }
        }
      }
    },
    "%@ water": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ víz"
          }
        }
      }
    },
