    "An estimate from population averages, adjusted for your goal. Individual needs vary — treat it as a starting point, and talk to a doctor or dietitian if you have health conditions or specific targets.": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Becslés populációs átlagok alapján, a célodhoz igazítva. Az egyéni szükséglet eltérő — tekintsd kiindulópontnak, és fordulj orvoshoz vagy dietetikushoz, ha betegséged vagy konkrét célod van."
          }
        }
      }
    },
    "Appearance": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megjelenés"
          }
        }
      }
    },
    "Apple Health isn't available on this device.": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Health nem érhető el ezen az eszközön."
          }
        }
      }
    },
    "Branded products, contributed by the public. Check the figures against the packaging before logging.": {
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Márkás termékek, közösségi adatokból. Naplózás előtt vesd össze az értékeket a csomagolással."
          }
        }
      }
    },
