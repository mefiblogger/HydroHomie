{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroHomie uses the camera to scan barcodes on food packaging and, if you ask it to, to photograph a meal so it can work out what is on the plate. Photos are read on your phone and are not saved or sent anywhere."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A HydroHomie a kamerát a csomagoláson lévő vonalkódok beolvasására használja, és ha kéred, egy étel lefényképezésére, hogy kitalálja, mi van a tányéron. A fényképeket a telefonod dolgozza fel, nem menti és nem küldi el sehová."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroHomie reads your weight, height, age and sex to suggest daily targets, and your water and nutrition so your totals stay in sync with Apple Health."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A HydroHomie beolvassa a testsúlyodat, magasságodat, életkorodat és nemedet a napi célok javaslásához, valamint a víz- és tápanyagbeviteledet, hogy az összesítésed szinkronban maradjon az Apple Health-szel."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HydroHomie saves the drinks and food you log to Apple Health as dietary water, energy and nutrients."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A HydroHomie a naplózott italokat és ételeket vízbevitelként, energiaként és tápanyagként menti az Apple Health-be."
          }
        }
      }
    }
  },
  "version": "1.0"
}
